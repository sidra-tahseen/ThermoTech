# Get a free NASA FIRMS MAP_KEY here:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_map_key_here

# Default region for Phase 1 (bounding box, area of interest)
# Format: west,south,east,north  -- default is roughly Telangana/AP
FIRMS_BBOX=76.5,15.5,81.5,19.5

# Which FIRMS source to pull (VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, MODIS_NRT, etc.)
FIRMS_SOURCE=VIIRS_SNPP_NRT

# How many days back to pull (FIRMS area API supports 1-10)
FIRMS_DAY_RANGE=1

# Phase 2 — matches docker-compose.yml's postgres service by default
DATABASE_URL=postgresql://geoflare:geoflare@localhost:5432/geoflare

# Phase 5 — rule-based classifier thresholds (used until a real model is trained)
FRP_THRESHOLD=40
PERSISTENT_COUNT_THRESHOLD=5
